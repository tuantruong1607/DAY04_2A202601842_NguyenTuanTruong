# Flight Search & Tracking Agent — copy to `.env` in this folder and fill in real values.
# NEVER commit `.env` — it is gitignored.

# --- Model provider (OpenAI-compatible chat completions with tool calling) ---
# Set ONE of these. If both are set, OPENAI_API_KEY takes priority.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- FlightAPI.io: airport/airline code lookup, one-way & round-trip price search ---
FLIGHTAPI_KEY=

# --- AeroDataBox via RapidAPI: flight status, airport arrivals/departures (FIDS) ---
RAPIDAPI_KEY=
RAPIDAPI_AERODATABOX_HOST=aerodatabox.p.rapidapi.com
